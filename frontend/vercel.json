{
  "headers": [
    {
      "source": "/(cart|checkout|order-confirmation|admin|order-pay/.*|checkout/order-pay/.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://lashon-hara-eu.onrender.com/api/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://lashon-hara-eu.onrender.com/api/sitemap.xml"
    },
    {
      "source": "/health",
      "destination": "https://lashon-hara-eu.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
